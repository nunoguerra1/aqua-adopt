# Banco LOCAL (Docker). Copie este arquivo para .env.
DATABASE_URL="postgresql://aqua:aqua@localhost:5432/aqua_adopt"
DIRECT_URL="postgresql://aqua:aqua@localhost:5432/aqua_adopt"

# Em produção (Vercel) estas variáveis apontam para o Neon:
# DATABASE_URL = conexão pooled (host com "-pooler")
# DIRECT_URL   = conexão direta (host sem "-pooler"), usada só em migrations
# Nunca coloque a URL de produção neste arquivo nem na .env local.

# E-mail. Sem SMTP_HOST (só em desenvolvimento), o link de acesso aparece no terminal.
# Exemplo com Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=seu@gmail.com,
# SMTP_PASSWORD=<senha de app: exige verificação em duas etapas na conta Google>
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="AquaAdopt <seu-email@exemplo.com>"